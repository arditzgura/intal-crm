rules_version = '2';

// INTAL PRO – Firestore Security Rules (Faza 1–5)
// Lejet e roleve zbatohen këtu, jo vetëm në UI. Çdo gjë që nuk lejohet
// shprehimisht është e ndaluar.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ndihmës ----------
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function bootstrapPath() { return /databases/$(database)/documents/meta/bootstrap; }
    function me() { return get(userPath(request.auth.uid)).data; }

    function isMember(companyId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && me().companyId == companyId
        && me().aktiv == true;
    }
    function hasRole(companyId, roles) { return isMember(companyId) && me().roli in roles; }
    function isAdmin(companyId) { return hasRole(companyId, ['admin']); }

    // Lejet për çdo përdorues (users/{uid}.lejet). Admini i ka të gjitha.
    // Përdoruesit pa `lejet` marrin shabllonin e rolit – njësoj si
    // src/config/permissions.js (TEMPLATES). Mbaji të sinkronizuara.
    function roleDefaults(r) {
      return r == 'shites'
        ? ['mod_fature_e_re', 'mod_historiku', 'mod_kliente', 'mod_artikujt', 'mod_inventari', 'fature_leshim', 'kliente_ndrysho', 'pagese']
        : r == 'finance'
          ? ['mod_historiku', 'mod_kliente', 'mod_blerje', 'mod_financa', 'mod_raporte', 'pagese', 'levizje_kartele', 'rregullim_gjendjeje', 'piket', 'sheh_koston', 'blerje_regjistro', 'financa_furnitore', 'financa_shpenzime', 'financa_arka']
          : r == 'magazinier'
            ? ['mod_artikujt', 'mod_blerje', 'mod_inventari', 'artikuj_ndrysho', 'sheh_koston', 'blerje_regjistro', 'inventar_rregullim']
            : [];
    }
    function myPerms() { return me().get('lejet', roleDefaults(me().roli)); }
    function can(companyId, perm) {
      return isMember(companyId) && (me().roli == 'admin' || perm in myPerms());
    }
    function canAny(companyId, perms) {
      return isMember(companyId) && (me().roli == 'admin' || myPerms().hasAny(perms));
    }

    function companyPath(companyId, col, id) {
      return /databases/$(database)/documents/companies/$(companyId)/$(col)/$(id);
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function counterIncreases() {
      return request.resource.data.next is int
        && (resource == null || request.resource.data.next > resource.data.next);
    }

    function validClient(d) {
      return d.emri is string && d.emri.size() > 0 && d.emri.size() <= 200
        && d.kodi is string
        && d.tipi in ['klient', 'furnitor', 'te_dyja']
        && d.monedhaPreferuar in ['LEK', 'EUR', 'USD']
        && d.arkivuar is bool;
    }

    // Klienti ndryshon gjendjen vetëm me 1–3 lëvizje të reja kartele (krijohen në të
    // njëjtin transaction, `lastLedgerIds`) dhe ndryshimi = shuma e tyre, në një monedhë.
    // `faturaFundit` (fatura që mban borxhin) ndryshon vetëm bashkë me to.
    function ledgerEntry(companyId, id) { return getAfter(companyPath(companyId, 'ledger', id)).data; }
    function isNewEntry(companyId, id, clientId, cur) {
      return !exists(companyPath(companyId, 'ledger', id))
        && ledgerEntry(companyId, id).clientId == clientId
        && ledgerEntry(companyId, id).monedha == cur;
    }
    function ledgerSum(companyId, ids) {
      return ids.size() == 1 ? ledgerEntry(companyId, ids[0]).shuma
        : ids.size() == 2 ? ledgerEntry(companyId, ids[0]).shuma + ledgerEntry(companyId, ids[1]).shuma
        : ledgerEntry(companyId, ids[0]).shuma + ledgerEntry(companyId, ids[1]).shuma + ledgerEntry(companyId, ids[2]).shuma;
    }
    function ledgerMatches(companyId, clientId) {
      let ids = request.resource.data.lastLedgerIds;
      let first = ledgerEntry(companyId, ids[0]);
      let cur = first.monedha;
      let ff = request.resource.data.get('faturaFundit', {});
      let ffOld = resource.data.get('faturaFundit', {});
      return ids is list && ids.size() >= 1 && ids.size() <= 3
        && isNewEntry(companyId, ids[0], clientId, cur)
        && (ids.size() < 2 || isNewEntry(companyId, ids[1], clientId, cur))
        && (ids.size() < 3 || isNewEntry(companyId, ids[2], clientId, cur))
        && request.resource.data.gjendje.diff(resource.data.gjendje).affectedKeys().hasOnly([cur])
        && request.resource.data.gjendje.get(cur, 0) == resource.data.gjendje.get(cur, 0) + ledgerSum(companyId, ids)
        && (
          request.resource.data.get('fillestare', {}) == resource.data.get('fillestare', {})
          || (first.tipi == 'gjendje_fillestare'
              && request.resource.data.fillestare.diff(resource.data.fillestare).affectedKeys().hasOnly([cur]))
        )
        && (
          ff == ffOld
          || (ff.diff(ffOld).affectedKeys().hasOnly([cur])
              && (ff.get(cur, null) == null
                  || getAfter(companyPath(companyId, 'invoices', ff[cur])).data.clientId == clientId))
        );
    }

    function invoiceAfter(companyId, id) { return getAfter(companyPath(companyId, 'invoices', id)).data; }
    // Fatura u lëshua në këtë kërkesë (transaction-i i lëshimit).
    function issuedNow(companyId, id) {
      return id is string && invoiceAfter(companyId, id).leshuar == request.time;
    }

    function validLedger(companyId, entryId) {
      let d = request.resource.data;
      let before = get(companyPath(companyId, 'clients', d.clientId)).data;
      let after = getAfter(companyPath(companyId, 'clients', d.clientId)).data;
      return d.uid == request.auth.uid
        && d.krijuar == request.time
        && d.monedha in ['LEK', 'EUR', 'USD']
        && d.shuma is int && d.shuma != 0
        && d.kursi is int && d.kursi > 0
        && d.data is timestamp
        && entryId in after.lastLedgerIds
        && d.gjendjaPas == d.gjendjaPara + d.shuma
        && (
          (d.tipi == 'pagese' && d.shuma < 0 && d.metoda in ['arke', 'banke']
            && (can(companyId, 'pagese') || (can(companyId, 'fature_leshim') && issuedNow(companyId, d.faturaId))))
          || (d.tipi in ['kthim', 'zbritje'] && d.shuma < 0 && can(companyId, 'levizje_kartele'))
          || (d.tipi == 'poste' && d.shuma > 0 && can(companyId, 'levizje_kartele'))
          || (d.tipi == 'rregullim' && d.arsye is string && d.arsye.size() > 0
            && can(companyId, 'rregullim_gjendjeje'))
          || (d.tipi == 'gjendje_fillestare' && can(companyId, 'rregullim_gjendjeje')
            && before.fillestare.get(d.monedha, false) == false
            && after.fillestare.get(d.monedha, false) == true)
          || (d.tipi == 'fature' && d.shuma > 0 && can(companyId, 'fature_leshim')
            && issuedNow(companyId, d.faturaId)
            && invoiceAfter(companyId, d.faturaId).clientId == d.clientId
            && invoiceAfter(companyId, d.faturaId).totali == d.shuma)
          || (d.tipi == 'anulim' && can(companyId, 'anulim_fature')
            && invoiceAfter(companyId, d.faturaId).statusi == 'anuluar'
            && invoiceAfter(companyId, d.faturaId).clientId == d.clientId)
        );
    }

    function pointsMatch(companyId, clientId) {
      let id = request.resource.data.lastPointsId;
      let e = getAfter(companyPath(companyId, 'loyaltyPoints', id)).data;
      return !exists(companyPath(companyId, 'loyaltyPoints', id))
        && e.clientId == clientId
        && request.resource.data.piket == resource.data.piket + e.pike;
    }

    function validPoints(companyId, entryId) {
      let d = request.resource.data;
      let before = get(companyPath(companyId, 'clients', d.clientId)).data;
      let after = getAfter(companyPath(companyId, 'clients', d.clientId)).data;
      return d.uid == request.auth.uid
        && d.krijuar == request.time
        && d.pike is int && d.pike != 0
        && before.rastesor == false
        && after.lastPointsId == entryId
        && d.piketPara == before.piket
        && d.piketPas == before.piket + d.pike
        && d.piketPas >= 0
        && (
          (d.tipi in ['rregullim', 'gjendje_fillestare'] && can(companyId, 'piket')
            && d.arsye is string && d.arsye.size() > 0)
          || (d.tipi == 'fituar' && d.pike > 0 && d.invoiceIds is list)
          || (d.tipi == 'anulim_fature' && d.pike < 0 && can(companyId, 'anulim_fature'))
        );
    }

    // Detyrimi ndaj furnitorit ndryshon vetëm me një lëvizje të re në supplierLedger.
    function supplierLedgerMatches(companyId, clientId) {
      let id = request.resource.data.lastSupplierLedgerId;
      let e = getAfter(companyPath(companyId, 'supplierLedger', id)).data;
      let oldMap = resource.data.get('detyrimFurnitori', {});
      return !exists(companyPath(companyId, 'supplierLedger', id))
        && e.clientId == clientId
        && request.resource.data.detyrimFurnitori.diff(oldMap).affectedKeys().hasOnly([e.monedha])
        && request.resource.data.detyrimFurnitori.get(e.monedha, 0) == oldMap.get(e.monedha, 0) + e.shuma;
    }
    function purchaseAfter(companyId, id) { return getAfter(companyPath(companyId, 'purchases', id)).data; }
    // Hyrja u regjistrua në këtë kërkesë.
    function purchasedNow(companyId, id) {
      return id is string && purchaseAfter(companyId, id).krijuar == request.time;
    }
    function purchaseOk(companyId, purchaseId) {
      let d = request.resource.data;
      let numPath = companyPath(companyId, 'purchaseNumbers', string(d.numri));
      return d.numri is int && d.numri > 0
        && !exists(numPath)
        && getAfter(numPath).data.purchaseId == purchaseId
        && d.statusi == 'regjistruar'
        && d.krijuar == request.time
        && d.krijuarNga.uid == request.auth.uid
        && d.totaliBlerje is int && d.totaliShitje is int
        && d.anuluar == null;
    }

    function paymentAfter(companyId, id) { return getAfter(companyPath(companyId, 'supplierPayments', id)).data; }
    function expenseAfter(companyId, id) { return getAfter(companyPath(companyId, 'expenses', id)).data; }
    function moneyDocOk(d) {
      return d.krijuar == request.time
        && d.krijuarNga.uid == request.auth.uid
        && d.statusi == 'aktiv' && d.anuluar == null
        && d.llogaria in ['arke', 'banke']
        && d.monedha in ['LEK', 'EUR', 'USD']
        && d.shuma is int && d.shuma > 0;
    }
    function moneyDocCancel() {
      return resource.data.statusi == 'aktiv'
        && request.resource.data.statusi == 'anuluar'
        && changedKeys().hasOnly(['statusi', 'anuluar'])
        && request.resource.data.anuluar.arsye is string && request.resource.data.anuluar.arsye.size() > 0
        && request.resource.data.anuluar.uid == request.auth.uid;
    }
    // Lëvizja e parave duhet të ketë burimin e saj të krijuar / anuluar në të njëjtën kërkesë.
    function validCash(companyId) {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.krijuar == request.time
        && d.llogaria in ['arke', 'banke']
        && d.monedha in ['LEK', 'EUR', 'USD']
        && d.shuma is int && d.shuma != 0
        && (
          (d.tipi == 'arketim' && d.shuma > 0
            && (can(companyId, 'pagese') || can(companyId, 'fature_leshim'))
            && !exists(companyPath(companyId, 'ledger', d.ledgerId))
            && ledgerEntry(companyId, d.ledgerId).tipi == 'pagese'
            && ledgerEntry(companyId, d.ledgerId).shuma == -d.shuma)
          || (d.tipi == 'kthim_klientit' && d.shuma < 0 && can(companyId, 'anulim_fature')
            && invoiceAfter(companyId, d.invoiceId).statusi == 'anuluar'
            && !exists(companyPath(companyId, 'ledger', d.ledgerId))
            && ledgerEntry(companyId, d.ledgerId).shuma == -d.shuma)
          || (d.tipi == 'shpenzim' && d.shuma < 0 && can(companyId, 'financa_shpenzime')
            && expenseAfter(companyId, d.refId).krijuar == request.time
            && expenseAfter(companyId, d.refId).shuma == -d.shuma)
          || (d.tipi == 'pagese_furnitori' && d.shuma < 0 && can(companyId, 'financa_furnitore')
            && paymentAfter(companyId, d.refId).krijuar == request.time
            && paymentAfter(companyId, d.refId).shuma == -d.shuma)
          || (d.tipi == 'anulim' && d.shuma > 0 && (
              (can(companyId, 'financa_shpenzime') && expenseAfter(companyId, d.refId).statusi == 'anuluar'
                && expenseAfter(companyId, d.refId).shuma == d.shuma)
              || (can(companyId, 'financa_furnitore') && paymentAfter(companyId, d.refId).statusi == 'anuluar'
                && paymentAfter(companyId, d.refId).shuma == d.shuma)))
          || (d.tipi in ['transferte', 'gjendje_fillestare', 'rregullim'] && can(companyId, 'financa_arka'))
        );
    }

    function isDraft(d) { return d.statusi == 'draft' && d.numri == null; }
    function issuedOk(companyId, invoiceId) {
      let d = request.resource.data;
      let numPath = companyPath(companyId, 'invoiceNumbers', string(d.numri));
      return d.numri is int && d.numri > 0
        && !exists(numPath)
        && getAfter(numPath).data.invoiceId == invoiceId
        && d.totali is int && d.paguar is int && d.paguar >= 0
        && d.gjendjaPara is int
        && d.gjendjaRe == d.gjendjaPara + d.totali - d.paguar
        && d.mbetur == d.gjendjaRe
        && d.statusi == (d.gjendjaRe <= 0 ? 'e_paguar' : 'pa_paguar')
        && d.leshuar == request.time
        && d.leshuarNga.uid == request.auth.uid
        && d.anuluar == null;
    }

    function validItem(d) {
      return d.emri is string && d.emri.size() > 0
        && d.kodi is string && d.kodi.matches('^[A-Z0-9._-]{1,30}$')
        && d.cmimi is int && d.cmimi >= 0
        && d.stokMinimal is int && d.stokMinimal >= 0
        && !('kosto' in d);
    }

    function validRole(r) { return r in ['admin', 'shites', 'finance', 'magazinier', 'personalizuar']; }
    function validUserDoc(d) {
      return d.keys().hasOnly(['companyId', 'roli', 'lejet', 'emri', 'email', 'aktiv', 'krijuar'])
        && (!('lejet' in d) || d.lejet is list)
        && d.companyId is string
        && validRole(d.roli)
        && d.emri is string && d.emri.size() > 0
        && d.email is string
        && d.aktiv is bool;
    }

    // ---------- Konfigurimi fillestar (vetëm një herë) ----------
    // Shënuesi krijohet në të njëjtin batch me Adminin e parë dhe nuk
    // ndryshohet / fshihet kurrë. Kur ekziston, askush s'mund të bëhet
    // Admin vetë; Adminët e rinj i krijon vetëm një Admin ekzistues.
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['adminUid', 'companyId', 'krijuar'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.companyId == 'intal'
        && getAfter(userPath(request.auth.uid)).data.roli == 'admin'
        && getAfter(userPath(request.auth.uid)).data.companyId == 'intal';
      allow update, delete: if false;
    }

    // ---------- Përdoruesit ----------
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin(resource.data.companyId));

      allow create: if signedIn() && validUserDoc(request.resource.data) && (
        // (a) Admini i parë: vetëm kur shënuesi nuk ekziston dhe krijohet në të njëjtin batch
        (
          request.auth.uid == uid
          && request.resource.data.roli == 'admin'
          && request.resource.data.aktiv == true
          && request.resource.data.companyId == 'intal'
          && !exists(bootstrapPath())
          && getAfter(bootstrapPath()).data.adminUid == uid
        )
        ||
        // (b) Admini krijon përdorues të tjerë në kompaninë e vet
        (
          request.auth.uid != uid
          && isAdmin(request.resource.data.companyId)
        )
      );

      // Vetëm Admini ndryshon përdoruesit e tjerë; askush nuk ndryshon veten
      // (pra askush nuk mund t'i japë vetes rol tjetër).
      allow update: if request.auth.uid != uid
        && isAdmin(resource.data.companyId)
        && validUserDoc(request.resource.data)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    // ---------- Të dhënat e kompanisë ----------
    match /companies/{companyId} {

      match /settings/{docId} {
        allow read: if isMember(companyId);
        allow write: if isAdmin(companyId);
      }

      // Numëruesit e dokumenteve. Admini i ndryshon nga Cilësimet; kush ka lejen
      // për klientë / artikuj vetëm i rrit (kodet KL### / A###).
      // Në Fazën 3 do të lejohet edhe rritja brenda lëshimit të faturës.
      match /counters/{key} {
        allow read: if isMember(companyId);
        allow write: if isAdmin(companyId)
          || (key == 'clients' && can(companyId, 'kliente_ndrysho') && counterIncreases())
          || (key == 'items' && can(companyId, 'artikuj_ndrysho') && counterIncreases())
          || (key == 'invoices' && can(companyId, 'fature_leshim') && counterIncreases())
          || (key == 'purchases' && can(companyId, 'blerje_regjistro') && counterIncreases());
      }

      // ---------- Klientët ----------
      // Gjendja (`gjendje`) dhe pikët (`piket`) ndryshojnë VETËM bashkë me një
      // lëvizje të re në kartelë / pikë, dhe saktësisht me shumën e saj.
      match /clients/{clientId} {
        allow read: if canAny(companyId, ['mod_kliente', 'mod_fature_e_re', 'mod_historiku', 'mod_financa', 'mod_raporte', 'mod_blerje', 'mod_shitjet', 'artikuj_ndrysho']);
        allow create: if can(companyId, 'kliente_ndrysho')
          && validClient(request.resource.data)
          && request.resource.data.gjendje == {}
          && request.resource.data.fillestare == {}
          && request.resource.data.piket == 0
          && request.resource.data.arkivuar == false
          && request.resource.data.rastesor == (clientId == 'klient-rastesor');
        allow update: if (
            // (A) të dhënat e profilit / arkivimi
            can(companyId, 'kliente_ndrysho')
            && !changedKeys().hasAny(['gjendje', 'fillestare', 'piket', 'lastLedgerId', 'lastLedgerIds', 'lastPointsId', 'faturaFundit', 'detyrimFurnitori', 'lastSupplierLedgerId', 'kodi', 'rastesor', 'krijuar'])
            && validClient(request.resource.data)
            && !(resource.data.rastesor == true && request.resource.data.arkivuar == true)
          ) || (
            // (B) lëvizje të reja në kartelë (leja kontrollohet te validLedger), me
            //     faturën që mban borxhin dhe pikët e fituara në të njëjtin transaction
            isMember(companyId)
            && changedKeys().hasOnly(['gjendje', 'fillestare', 'lastLedgerIds', 'faturaFundit', 'piket', 'lastPointsId'])
            && changedKeys().hasAny(['lastLedgerIds'])
            && ledgerMatches(companyId, clientId)
            && (!changedKeys().hasAny(['piket', 'lastPointsId']) || pointsMatch(companyId, clientId))
          ) || (
            // (C) lëvizje e re pikësh
            can(companyId, 'piket')
            && changedKeys().hasOnly(['piket', 'lastPointsId'])
            && pointsMatch(companyId, clientId)
          ) || (
            // (D) detyrimi ndaj furnitorit (leja kontrollohet te supplierLedger)
            isMember(companyId)
            && changedKeys().hasOnly(['detyrimFurnitori', 'lastSupplierLedgerId'])
            && supplierLedgerMatches(companyId, clientId)
          );
        allow delete: if false;
      }

      // Kartela: vetëm shtim. Gabimet korrigjohen me lëvizje të kundërt.
      match /ledger/{entryId} {
        allow read: if canAny(companyId, ['mod_kliente', 'mod_financa', 'mod_raporte']);
        allow create: if validLedger(companyId, entryId);
        allow update, delete: if false;
      }

      match /loyaltyPoints/{entryId} {
        allow read: if can(companyId, 'mod_kliente');
        allow create: if isMember(companyId) && validPoints(companyId, entryId);
        allow update, delete: if false;
      }

      // ---------- Artikujt ----------
      match /items/{itemId} {
        allow read: if isMember(companyId);
        allow create, update: if can(companyId, 'artikuj_ndrysho')
          && validItem(request.resource.data)
          && ((resource != null && request.resource.data.kodi == resource.data.kodi)
              || getAfter(companyPath(companyId, 'itemCodes', request.resource.data.kodi)).data.itemId == itemId);
        allow delete: if false;
      }

      // Kodi unik i artikullit: një dokument për çdo kod.
      match /itemCodes/{code} {
        allow read: if can(companyId, 'artikuj_ndrysho');
        allow create: if can(companyId, 'artikuj_ndrysho')
          && getAfter(companyPath(companyId, 'items', request.resource.data.itemId)).data.kodi == code;
        allow delete: if can(companyId, 'artikuj_ndrysho')
          && getAfter(companyPath(companyId, 'items', resource.data.itemId)).data.kodi != code;
        allow update: if false;
      }

      // Kosto (çmimi i blerjes) – vetëm me lejen "sheh_koston".
      match /itemCosts/{itemId} {
        allow read: if can(companyId, 'sheh_koston');
        allow write: if can(companyId, 'sheh_koston')
          && request.resource.data.keys().hasOnly(['kosto', 'burim'])
          && (request.resource.data.kosto == null
              || (request.resource.data.kosto is int && request.resource.data.kosto >= 0))
          && (can(companyId, 'artikuj_ndrysho')
              || (can(companyId, 'blerje_regjistro') && purchasedNow(companyId, request.resource.data.burim)));
      }

      match /preferentialPrices/{priceId} {
        allow read: if isMember(companyId);
        allow create, update: if can(companyId, 'artikuj_ndrysho')
          && priceId == request.resource.data.itemId + '_' + request.resource.data.clientId
          && request.resource.data.cmimi is int && request.resource.data.cmimi >= 0;
        allow delete: if can(companyId, 'artikuj_ndrysho');
      }

      // ---------- Faturat ----------
      // Drafti ndryshohet / fshihet lirisht. Fatura e lëshuar nuk ndryshohet: lejohen
      // vetëm fushat e zinxhirit (statusi, mbetur, faturaPas, piketDhene) dhe anulimi.
      match /invoices/{invoiceId} {
        allow read: if canAny(companyId, ['mod_historiku', 'mod_fature_e_re', 'mod_kliente', 'mod_raporte', 'mod_financa', 'mod_shitjet']);
        allow create: if can(companyId, 'fature_leshim')
          && (isDraft(request.resource.data) || issuedOk(companyId, invoiceId));
        allow update: if (
            resource.data.statusi == 'draft' && can(companyId, 'fature_leshim')
            && (isDraft(request.resource.data) || issuedOk(companyId, invoiceId))
          ) || (
            resource.data.statusi in ['pa_paguar', 'pasuar', 'e_paguar'] && isMember(companyId)
            && changedKeys().hasOnly(['statusi', 'mbetur', 'faturaPas', 'piketDhene'])
            && request.resource.data.statusi in ['pa_paguar', 'pasuar', 'e_paguar']
          ) || (
            resource.data.statusi in ['pa_paguar', 'pasuar', 'e_paguar'] && can(companyId, 'anulim_fature')
            && request.resource.data.statusi == 'anuluar'
            && changedKeys().hasOnly(['statusi', 'anuluar', 'piketDhene'])
            && request.resource.data.anuluar.arsye is string && request.resource.data.anuluar.arsye.size() > 0
            && request.resource.data.anuluar.uid == request.auth.uid
          );
        allow delete: if resource.data.statusi == 'draft' && can(companyId, 'fature_leshim');
      }

      // Një dokument për çdo numër fature: krijohet vetëm një herë → numra unikë.
      match /invoiceNumbers/{n} {
        allow read: if can(companyId, 'fature_leshim');
        allow create: if can(companyId, 'fature_leshim')
          && invoiceAfter(companyId, request.resource.data.invoiceId).numri == int(n);
        allow update, delete: if false;
      }

      match /invoiceLines/{lineId} {
        allow read: if canAny(companyId, ['mod_kliente', 'mod_artikujt', 'mod_raporte', 'mod_historiku', 'mod_shitjet']);
        allow create: if can(companyId, 'fature_leshim')
          && issuedNow(companyId, request.resource.data.invoiceId)
          && request.resource.data.anuluar == false;
        allow update: if can(companyId, 'anulim_fature')
          && changedKeys().hasOnly(['anuluar']) && request.resource.data.anuluar == true;
        allow delete: if false;
      }

      // Lëvizjet e stokut: vetëm shtim. Burimi i së vërtetës për stokun.
      match /stockMovements/{movementId} {
        allow read: if canAny(companyId, ['mod_inventari', 'mod_artikujt', 'mod_blerje', 'mod_raporte']);
        allow create: if request.resource.data.uid == request.auth.uid
          && request.resource.data.krijuar == request.time
          && request.resource.data.sasia is int && request.resource.data.sasia != 0 && (
            (request.resource.data.tipi == 'dalje' && request.resource.data.sasia < 0
              && can(companyId, 'fature_leshim') && issuedNow(companyId, request.resource.data.invoiceId))
            || (request.resource.data.tipi == 'kthim_anulim' && request.resource.data.sasia > 0
              && can(companyId, 'anulim_fature')
              && invoiceAfter(companyId, request.resource.data.invoiceId).statusi == 'anuluar')
            || (request.resource.data.tipi == 'hyrje' && request.resource.data.sasia > 0
              && can(companyId, 'blerje_regjistro') && purchasedNow(companyId, request.resource.data.purchaseId))
            || (request.resource.data.tipi == 'anulim_hyrje' && request.resource.data.sasia < 0
              && can(companyId, 'blerje_anulo')
              && purchaseAfter(companyId, request.resource.data.purchaseId).statusi == 'anuluar')
            || (request.resource.data.tipi == 'rregullim' && can(companyId, 'inventar_rregullim')
              && request.resource.data.arsye is string && request.resource.data.arsye.size() > 0)
          );
        allow update, delete: if false;
      }

      // Kopja e stokut për shpejtësi (increment në të njëjtin transaction me lëvizjen).
      // Mund të rindërtohet nga Admini me "Rillogarit stokun".
      match /stock/{itemId} {
        allow read: if isMember(companyId);
        allow create, update: if canAny(companyId, ['fature_leshim', 'anulim_fature', 'blerje_regjistro', 'blerje_anulo', 'inventar_rregullim'])
          && request.resource.data.keys().hasOnly(['sasia', 'rillogaritur'])
          && request.resource.data.sasia is int;
        allow delete: if false;
      }

      // ---------- Blerje (hyrje malli) ----------
      match /purchases/{purchaseId} {
        allow read: if can(companyId, 'mod_blerje');
        allow create: if can(companyId, 'blerje_regjistro') && purchaseOk(companyId, purchaseId);
        allow update: if can(companyId, 'blerje_anulo')
          && resource.data.statusi == 'regjistruar'
          && request.resource.data.statusi == 'anuluar'
          && changedKeys().hasOnly(['statusi', 'anuluar'])
          && request.resource.data.anuluar.arsye is string && request.resource.data.anuluar.arsye.size() > 0
          && request.resource.data.anuluar.uid == request.auth.uid;
        allow delete: if false;
      }

      match /purchaseNumbers/{n} {
        allow read: if can(companyId, 'blerje_regjistro');
        allow create: if can(companyId, 'blerje_regjistro')
          && purchaseAfter(companyId, request.resource.data.purchaseId).numri == int(n);
        allow update, delete: if false;
      }

      // Kartela e furnitorit: vetëm shtim (blerje +, anulim / pagesë −).
      match /supplierLedger/{entryId} {
        allow read: if canAny(companyId, ['mod_blerje', 'mod_financa', 'mod_kliente']);
        allow create: if request.resource.data.uid == request.auth.uid
          && request.resource.data.krijuar == request.time
          && request.resource.data.monedha in ['LEK', 'EUR', 'USD']
          && request.resource.data.shuma is int && request.resource.data.shuma != 0
          && request.resource.data.detyrimiPas == request.resource.data.detyrimiPara + request.resource.data.shuma
          && getAfter(companyPath(companyId, 'clients', request.resource.data.clientId)).data.lastSupplierLedgerId == entryId
          && (
            (request.resource.data.tipi == 'blerje' && request.resource.data.shuma > 0
              && can(companyId, 'blerje_regjistro')
              && purchasedNow(companyId, request.resource.data.purchaseId)
              && purchaseAfter(companyId, request.resource.data.purchaseId).furnitorId == request.resource.data.clientId
              && purchaseAfter(companyId, request.resource.data.purchaseId).totaliBlerje == request.resource.data.shuma)
            || (request.resource.data.tipi == 'anulim_blerje' && request.resource.data.shuma < 0
              && can(companyId, 'blerje_anulo')
              && purchaseAfter(companyId, request.resource.data.purchaseId).statusi == 'anuluar')
            || (request.resource.data.tipi == 'pagese_furnitori' && request.resource.data.shuma < 0
              && can(companyId, 'financa_furnitore')
              && paymentAfter(companyId, request.resource.data.paymentId).krijuar == request.time
              && paymentAfter(companyId, request.resource.data.paymentId).clientId == request.resource.data.clientId
              && paymentAfter(companyId, request.resource.data.paymentId).shuma == -request.resource.data.shuma)
            || (request.resource.data.tipi == 'anulim_pagese' && request.resource.data.shuma > 0
              && can(companyId, 'financa_furnitore')
              && paymentAfter(companyId, request.resource.data.paymentId).statusi == 'anuluar'
              && paymentAfter(companyId, request.resource.data.paymentId).shuma == request.resource.data.shuma)
          );
        allow update, delete: if false;
      }

      // Historiku i kostos (fitimi me koston në datën e faturës).
      match /costHistory/{entryId} {
        allow read: if can(companyId, 'sheh_koston');
        allow create: if can(companyId, 'sheh_koston') && request.resource.data.kosto is int && (
            (can(companyId, 'artikuj_ndrysho') && request.resource.data.nga == request.time)
            || (can(companyId, 'blerje_regjistro') && request.resource.data.nga is timestamp
                && purchasedNow(companyId, request.resource.data.burim))
          );
        allow update, delete: if false;
      }

      // ---------- Financa ----------
      // Arka / banka: vetëm shtim; çdo lëvizje lidhet me burimin e saj.
      match /cashMovements/{movementId} {
        allow read: if canAny(companyId, ['mod_financa', 'mod_raporte']);
        allow create: if validCash(companyId);
        allow update, delete: if false;
      }

      // Kopja e gjendjes së arkës/bankës (increment); Admini e rindërton nga lëvizjet.
      match /cashBalances/{docId} {
        allow read: if canAny(companyId, ['mod_financa', 'mod_raporte']);
        allow write: if canAny(companyId, ['pagese', 'fature_leshim', 'anulim_fature', 'financa_furnitore', 'financa_shpenzime', 'financa_arka'])
          && request.resource.data.keys().hasOnly(['arke', 'banke', 'rillogaritur']);
      }

      match /expenses/{expenseId} {
        allow read: if canAny(companyId, ['mod_financa', 'mod_raporte']);
        allow create: if can(companyId, 'financa_shpenzime') && moneyDocOk(request.resource.data)
          && request.resource.data.kategoria is string;
        allow update: if can(companyId, 'financa_shpenzime') && moneyDocCancel();
        allow delete: if false;
      }

      match /supplierPayments/{paymentId} {
        allow read: if canAny(companyId, ['mod_financa', 'mod_blerje', 'mod_raporte']);
        allow create: if can(companyId, 'financa_furnitore') && moneyDocOk(request.resource.data)
          && request.resource.data.clientId is string;
        allow update: if can(companyId, 'financa_furnitore') && moneyDocCancel();
        allow delete: if false;
      }

      // Log-u i veprimeve: vetëm shtim, kurrë ndryshim ose fshirje.
      match /auditLog/{entryId} {
        allow read: if can(companyId, 'sheh_logun')
          || (can(companyId, 'mod_historiku') && resource.data.entity == 'invoices');
        allow create: if isMember(companyId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.koha == request.time;
        allow update, delete: if false;
      }
    }
  }
}
